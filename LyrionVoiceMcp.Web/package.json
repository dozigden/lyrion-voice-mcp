{
  "name": "lyrion-voice-mcp-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,vue}\" \"*.{ts,mjs}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "sync:third-party-licences": "node ./scripts/sync-third-party-licences.mjs --publish-public",
    "refresh:licence-inventory": "LVM_REFRESH_LICENCE_INVENTORY=1 vite build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.6"
  }
}
