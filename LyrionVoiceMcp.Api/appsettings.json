{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LyrionVoiceMcpLms": {
    "ServerId": "",
    "BaseUrl": "",
    "RequestTimeoutSeconds": 5
  },
  "LyrionVoiceMcpObservations": {
    "DatabasePath": "../.data/search-observations.db",
    "RetentionDays": 90
  },
  "LyrionVoiceMcpCatalogue": {
    "DatabasePath": "../.data/catalogue.db"
  },
  "LyrionVoiceMcpOperations": {
    "DatabasePath": "../.data/operations.db",
    "JobRetentionDays": 90,
    "ErrorRetentionDays": 90,
    "ToolCallRetentionDays": 30,
    "ToolCallJsonMaximumCharacters": 262144,
    "Schedules": {
      "CatalogueRefresh": { "Enabled": false, "Cron": "0 3 * * *" },
      "ErrorLogPurge": { "Enabled": true, "Cron": "15 3 * * *" },
      "JobHistoryPurge": { "Enabled": true, "Cron": "30 3 * * *" },
      "ToolCallHistoryPurge": { "Enabled": true, "Cron": "45 3 * * *" }
    }
  },
  "LyrionVoiceMcpEvaluation": {
    "IndexDirectoryPath": "../.data/search-indexes"
  },
  "AllowedHosts": "*"
}
