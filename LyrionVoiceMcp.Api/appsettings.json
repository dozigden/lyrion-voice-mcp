{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LyrionVoiceMcpLms": {
    "ServerId": "",
    "BaseUrl": "",
    "RequestTimeoutSeconds": 5
  },
  "LyrionVoiceMcpPersistence": {
    "DatabasePath": "../.data/lyrion-voice-mcp.db"
  },
  "LyrionVoiceMcpObservations": {
    "RetentionDays": 90
  },
  "LyrionVoiceMcpOperations": {
    "JobRetentionDays": 90,
    "ErrorRetentionDays": 90,
    "ToolCallRetentionDays": 30,
    "ToolCallJsonMaximumCharacters": 262144,
    "Schedules": {
      "CatalogueRefresh": { "Enabled": false, "Cron": "0 3 * * *" },
      "ErrorLogPurge": { "Enabled": true, "Cron": "15 3 * * *" },
      "JobHistoryPurge": { "Enabled": true, "Cron": "30 3 * * *" },
      "ToolCallHistoryPurge": { "Enabled": true, "Cron": "45 3 * * *" }
    }
  },
  "LyrionVoiceMcpSearch": {
    "IndexDirectoryPath": "../.data/search-index"
  },
  "AllowedHosts": "*"
}
